{
  "name": "dsh-plugin-matlab",
  "version": "1.2.0",
  "description": "Adds the MathWorks MATLAB Agentic Toolkit skills and the MATLAB MCP Server tools to DeepSeek Harness. Needs a local MATLAB R2021a or later. By default (autoProvision) it downloads the MathWorks MCP Server binary, verified against the release's published SHA-256 digest, and installs the newest Agentic Toolkit release on first use, and MathWorks telemetry is disabled unless the user turns it back on.",
  "license": "MIT",
  "author": {
    "name": "小涛29",
    "email": "xuyuntao@189.cn"
  },
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tedcriss/dsh-matlab.git"
  },
  "homepage": "https://github.com/tedcriss/dsh-matlab#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "matlab",
    "simulink",
    "mcp",
    "skills",
    "mathworks"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "cordis.patch.yml",
    "client/*.js",
    "locale/*.json",
    "screenshots.json",
    "lib/index.js",
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/dsh-skill-filesystem": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
