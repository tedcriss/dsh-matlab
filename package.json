{
  "name": "dsh-plugin-matlab",
  "version": "0.1.0",
  "description": "Bring MathWorks MATLAB Agentic Toolkit skills and MATLAB MCP Server tools to DeepSeek Harness by pointing at what MATLAB already ships.",
  "license": "MIT",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tedcriss/dsh-matlab.git"
  },
  "homepage": "https://github.com/tedcriss/dsh-matlab#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "matlab",
    "simulink",
    "mcp",
    "skills",
    "mathworks"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "cordis.patch.yml",
    "client/*.js",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/dsh-skill-filesystem": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
